# Copy to .env (gitignored) and fill in. The app reads these from the environment.

# OCR backend: "medgemma" (local, default) or "claude" (cloud)
OCR_PROVIDER=medgemma

# CPU-only GGUF experiment (requires Ollama and qwen3-vl:4b-instruct)
# OCR_PROVIDER=ollama
# OLLAMA_MODEL=qwen3-vl:4b-instruct
# OLLAMA_URL=http://127.0.0.1:11434

# Required only when OCR_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4-8

# Required only for the local MedGemma path (gated model download)
# HF_TOKEN=hf_...

# Override the URL encoded in the scan QR code (use when a tunnel like
# cloudflared/ngrok is needed because the phone can't reach the laptop's LAN IP)
# PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# Local OpenMRS 3 Reference Application (docker-compose.openmrs.yml)
OPENMRS_TAG=demo
OPENMRS_PORT=8080
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=openmrs
OPENMRS_DB_ROOT_PASSWORD=openmrs

# De-paperfy -> OpenMRS FHIR2 integration (development defaults only)
OPENMRS_BASE_URL=http://localhost:8080/openmrs
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123
OPENMRS_TIMEOUT=30
DEPAPERFY_PORT=8000
OPENMRS_PUBLIC_URL=http://localhost:8080/openmrs
DEPAPERFY_OCR_PROVIDER=ollama

# "mock" preserves the original mock pages; Compose sets this to "openmrs".
EHR_MODE=mock
